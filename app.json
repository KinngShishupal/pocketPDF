{
  "expo": {
    "name": "1TapPDF",
    "slug": "1tappdf",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "onetappdf",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.kinngshishupal.onetappdf",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "1TapPDF converts your speech into text for your documents.",
        "NSMicrophoneUsageDescription": "1TapPDF uses the microphone so you can type documents by speaking."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E8173A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kinngshishupal.onetappdf",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07070F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 132
        }
      ],
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "1TapPDF uses the camera to scan your documents.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "1TapPDF needs access to your photos to turn them into PDFs.",
          "cameraPermission": "1TapPDF uses the camera to scan your documents.",
          "microphonePermission": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "1TapPDF uses the microphone so you can type documents by speaking.",
          "speechRecognitionPermission": "1TapPDF converts your speech into text for your documents.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#07070F",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f3d310e3-9dfc-4962-bc93-dec6534216da"
      }
    }
  }
}
